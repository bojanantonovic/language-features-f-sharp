<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Language_Features_F_Sharp</RootNamespace>
        <LangVersion>preview</LangVersion>
        <WarningLevel>3</WarningLevel>
        <NoWarn>FS0057;FS3511</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Features/Aliases.fs"/>
        <Compile Include="Features/Demo.fs"/>
        <Compile Include="Features/F01_VariablesAndTypes.fs"/>
        <Compile Include="Features/F02_OperatorsAndControlFlow.fs"/>
        <Compile Include="Features/F03_PatternMatching.fs"/>
        <Compile Include="Features/F04_ClassesStructsRecords.fs"/>
        <Compile Include="Features/F05_InheritancePolymorphism.fs"/>
        <Compile Include="Features/F06_Generics.fs"/>
        <Compile Include="Features/F07_DelegatesEventsLambdas.fs"/>
        <Compile Include="Features/F08_Collections.fs"/>
        <Compile Include="Features/F09_Linq.fs"/>
        <Compile Include="Features/F10_Strings.fs"/>
        <Compile Include="Features/F11_ExceptionHandling.fs"/>
        <Compile Include="Features/F12_Async.fs"/>
        <Compile Include="Features/F13_Iterators.fs"/>
        <Compile Include="Features/F14_SpanAndMemory.fs"/>
        <Compile Include="Features/F15_ReflectionAttributes.fs"/>
        <Compile Include="Features/F16_OperatorOverloading.fs"/>
        <Compile Include="Features/F17_NullableReferenceTypes.fs"/>
        <Compile Include="Features/F18_ModernSyntax.fs"/>
        <Compile Include="Features/F19_RefOutInAndUnsafe.fs"/>
        <Compile Include="Features/F20_EnumsAndFlags.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

</Project>
